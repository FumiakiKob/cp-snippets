  "Portable Hash Table": {
    "scope": "scheme",
    "prefix": "/hash-table",
    "body": [
      ";; ハッシュテーブル",
      "(define (hash key size)",
      "  (let loop ((chars (string->list (symbol->string key))) (h 0))",
      "    (if (null? chars)",
      "        h",
      "        (loop (cdr chars)",
      "              (modulo (+ (* h 31) (char->integer (car chars))) size)))))",
      "(define (make-hash-table size)",
      "  (make-vector size '()))",
      "(define (hash-table-put! ht key val)",
      "  (let* ((size (vector-length ht))",
      "         (idx (hash key size))",
      "         (bucket (vector-ref ht idx))",
      "         (pair (assoc key bucket)))",
      "    (if pair",
      "        (set-cdr! pair val)",
      "        (vector-set! ht idx (cons (cons key val) bucket)))))",
      "(define (hash-table-get ht key default-val)",
      "  (let* ((size (vector-length ht))",
      "         (idx (hash key size))",
      "         (bucket (vector-ref ht idx))",
      "         (pair (assoc key bucket)))",
      "    (if pair",
      "        (cdr pair)",
      "        default-val)))"
    ],
    "description": "Portable Hash Table"
  },
  "Merge Sort": {
    "scope": "scheme",
    "prefix": "/merge-sort",
    "body": [
      "(define (merge-sort compare lst)",
      "  (define (split-at lst n)",
      "    (let loop ((i n) (head '()) (tail lst))",
      "      (if (or (= i 0) (null? tail))",
      "          (list (reverse head) tail)",
      "          (loop (- i 1) (cons (car tail) head) (cdr tail)))))",
      "  (define (merge left-half right-half)",
      "    (let loop ((lh left-half) (rh right-half) (acc '()))",
      "      (cond ((null? lh)",
      "             (append (reverse acc) rh))",
      "            ((null? rh)",
      "             (append (reverse acc) lh))",
      "            ((compare (car lh) (car rh))",
      "             (loop (cdr lh) rh (cons (car lh) acc)))",
      "            (else",
      "             (loop lh (cdr rh) (cons (car rh) acc))))))",
      "  (let sort ((lst lst))",
      "    (let ((len (length lst)))",
      "      (if (> len 1)",
      "          (apply merge",
      "            (map sort",
      "              (split-at lst (div len 2))))",
      "          lst))))"
    ],
    "description": "Merge Sort"
