      "         (let ((p-left (tree-priority left))",
      "               (p-right (tree-priority right)))",
      "           (if (> p-left p-right)",
      "               (make-tree (tree-key left)",
      "                          (tree-priority left)",
      "                          (tree-left left)",
      "                          (tree-merge (tree-right left) right))",
      "               (make-tree (tree-key right)",
      "                          (tree-priority right)",
      "                          (tree-merge left (tree-left right))",
      "                          (tree-right right)))))))",
      ";; ランダムな優先度",
      "(define random-priority",
      "  (let ((seed 123456789))",
      "    (lambda ()",
      "      (let ((a 1103515245)",
      "            (c 12345)",
      "            (m 4294967296))",
      "        (set! seed (modulo (+ (* seed a) c) m))",
      "        seed))))",
      ";; ノードの更新",
      "(define (tree-update compare tree k updater)",
      "  (let* ((result (tree-split3 compare tree k))",
      "         (L (car result))",
      "         (M (cadr result))",
      "         (R (caddr result)))",
      "    (tree-merge L (tree-merge (updater M) R))))",
      ";; 検索",
      "(define (tree-member compare k tree)",
      "  (if (null? tree)",
      "      #f",
      "      (let ((key (tree-key tree)))",
      "        (cond ((compare k key)",
      "               (tree-member compare k (tree-left tree)))",
      "              ((compare key k)",
      "               (tree-member compare k (tree-right tree)))",
      "              (else",
      "               tree)))))",
      ";; 変換",
      "(define (tree->list tree)",
      "  (if (null? tree)",
      "      '()",
      "      (append",
      "        (tree->list (tree-left tree))",
      "        (list (tree-key tree))",
      "        (tree->list (tree-right tree)))))",
      ";; ラッパー",
      "(define (make-set compare)",
      "  (cons compare '()))",
      "(define (set-adjoin set key)",
      "  (let ((compare (car set))",
      "        (tree (cdr set))",
      "        (updater (lambda (x)",
      "                   (if (null? x)",
      "                       (make-tree key (random-priority) '() '())",
      "                       (make-tree key (tree-priority x) (tree-left x) (tree-right x))))))",
      "    (cons compare (tree-update compare tree key updater))))",
      "(define (set-delete set key)",
      "  (let ((compare (car set))",
      "        (tree (cdr set))",
      "        (updater (lambda (x) '())))",
      "    (cons compare (tree-update compare tree key updater))))",
      "(define (set-element? set key)",
      "  (let* ((compare (car set))",
      "         (tree (cdr set))",
      "         (match (tree-member compare key tree)))",
      "    (if match",
      "        #t",
      "        #f)))"
    ],
    "description": "Set"
  },
  "Bag": {
    "scope": "scheme",
    "prefix": "/bag",
    "body": [
      ";; Bag",
      ";; コンストラクタ",
      "(define (make-tree key priority value left right)",
      "  (list key priority value left right))",
      ";; セレクタ",
      "(define (tree-key tree) (car tree))",
      "(define (tree-priority tree) (cadr tree))",
      "(define (tree-value tree) (list-ref tree 2))",
      "(define (tree-left tree) (list-ref tree 3))",
      "(define (tree-right tree) (list-ref tree 4))",
      ";; 3分割",
      "(define (tree-split3 compare tree k)",
      "  (if (null? tree)",
      "      (list '() '() '())",
      "      (let ((key (tree-key tree))",
      "            (priority (tree-priority tree))",
      "            (value (tree-value tree))",
      "            (left (tree-left tree))",
      "            (right (tree-right tree)))",
      "        (cond ",
      "          ((compare k key)",
      "           (let* ((result (tree-split3 compare left k))",
      "                  (L (car result))",
      "                  (M (cadr result))",
      "                  (R (caddr result)))",
      "            (list L M (make-tree key priority value R right))))",
      "          ((compare key k)",
      "           (let* ((result (tree-split3 compare right k))",
      "                  (L (car result))",
      "                  (M (cadr result))",
      "                  (R (caddr result)))",
      "            (list (make-tree key priority value left L) M R)))",
      "          (else",
      "           (list left",
      "                 (make-tree key priority value '() '())",
      "                 right))))))",
      ";; 和（左の全要素 < 右の全要素が前提）",
      "(define (tree-merge left right)",
      "  (cond",
      "    ((null? left) right)",
      "    ((null? right) left)",
      "    (else",
      "      (let ((p-left (tree-priority left))",
      "            (p-right (tree-priority right)))",
      "        (if (> p-left p-right)",
      "          (make-tree (tree-key left)",
      "                     (tree-priority left)",
      "                     (tree-value left)",
      "                     (tree-left left)",
      "                     (tree-merge (tree-right left) right))",
      "          (make-tree (tree-key right)",
      "                     (tree-priority right)",
      "                     (tree-value right)",
      "                     (tree-merge left (tree-left right))",
      "                     (tree-right right)))))))",
      ";; ランダムな優先度",
      "(define random-priority",
      "  (let ((seed 123456789))",
      "    (lambda ()",
      "      (let ((a 1103515245)",
      "            (c 12345)",
      "            (m 4294967296))",
      "        (set! seed (modulo (+ (* seed a) c) m))",
      "        seed))))",
      ";; ノードの更新",
      "(define (tree-update compare tree k updater)",
      "  (let* ((result (tree-split3 compare tree k))",
      "         (L (car result))",
      "         (M (cadr result))",
      "         (R (caddr result)))",
      "    (tree-merge L (tree-merge (updater M) R))))",
      ";; 検索",
      "(define (tree-member compare k tree)",
      "  (if (null? tree)",
      "      #f",
      "      (let ((key (tree-key tree)))",
      "        (cond",
      "          ((compare k key)",
      "           (tree-member compare k (tree-left tree)))",
      "          ((compare key k)",
      "           (tree-member compare k (tree-right tree)))",
      "          (else tree)))))",
      "(define (tree-left-most tree)",
      "  (if (null? (tree-left tree))",
      "    (cons (tree-key tree) (tree-value tree))",
      "    (tree-left-most (tree-left tree))))",
      "(define (tree-right-most tree)",
      "  (if (null? (tree-right tree))",
      "    (cons (tree-key tree) (tree-value tree))",
      "    (tree-right-most (tree-right tree))))",
      ";; 変換",
      "(define (tree->alist tree)",
      "  (if (null? tree)",
      "    '()",
      "    (append",
      "      (tree->alist (tree-left tree))",
      "      (list (cons (tree-key tree) (tree-value tree)))",
      "      (tree->alist (tree-right tree)))))",
      ";; ラッパー",
      "(define (make-bag compare)",
      "  (cons compare '()))",
      "(define (bag-push bag key)",
      "  (let ((compare (car bag))",
      "        (tree (cdr bag))",
      "        (updater (lambda (x)",
      "                  (if (null? x)",
      "                    (make-tree key (random-priority) 1 '() '())",
      "                    (make-tree key (tree-priority x) (+ 1 (tree-value x)) (tree-left x) (tree-right x))))))",
      "    (cons compare (tree-update compare tree key updater))))",
      "(define (bag-pop bag key)",
      "  (let ((compare (car bag))",
      "        (tree (cdr bag))",
      "        (updater (lambda (x)",
      "                  (if (= 1 (tree-value x))",
      "                    '()",
      "                    (make-tree key (tree-priority x) (- (tree-value x) 1) (tree-left x) (tree-right x))))))",
      "    (cons compare (tree-update compare tree key updater))))",
      "(define (bag-find bag key)",
      "  (let* ((compare (car bag))",
      "         (tree (cdr bag))",
      "         (match (tree-member compare key tree)))",
      "    (if match",
      "      (cons key (tree-value match))",
      "      #f)))",
      "(define (bag->alist bag)",
      "  (tree->alist (cdr bag)))",
      "(define (bag-min bag)",
      "  (car (tree-left-most (cdr bag))))",
      "(define (bag-max bag)",
      "  (car (tree-right-most (cdr bag))))"
    ],
    "description": "Bag"
  },
  "Union-Find": {
    "scope": "scheme",
    "prefix": "/union-find",
    "body": [
      ";; Union-Find",
      "(define (make-union-find N)",
      "  (let ((parents (make-vector N))",
      "        (sizes (make-vector N 1)))",
      "    ;; ルートを見つける（経路圧縮付き）",
      "    (define (root k)",
      "      (let ((p (vector-ref parents k)))",
      "        (if (= p k)",
      "            k",
      "            (let ((r (root p)))",
      "              (vector-set! parents k r)",
      "              r))))",
      "    ;; 結合する（Union by Size）",
      "    (define (unite! k l)",
      "      (let ((rk (root k))",
      "            (rl (root l)))",
      "        (unless (= rk rl) ; ルート同士が違う場合のみ処理する",
      "          (let ((sk (vector-ref sizes rk))",
      "                (sl (vector-ref sizes rl)))",
      "            (if (< sk sl)",
      "                (begin",
      "                  (vector-set! parents rk rl)",
      "                  (vector-set! sizes rl (+ sk sl)))",
      "                (begin",
      "                  (vector-set! parents rl rk)",
      "                  (vector-set! sizes rk (+ sk sl))))))))",
      "    ;; 同じグループか判定する",
      "    (define (same? k l)",
      "      (= (root k) (root l)))",
      "    ;; 属しているグループのサイズを取得する",
      "    (define (size k)",
      "      (vector-ref sizes (root k)))",
      "    ;; 初期化: 最初はすべての頂点が自分自身を親とする（独立した木）",
      "    (let loop ((i 0))",
      "      (when (< i N)",
      "        (vector-set! parents i i)",
      "        (loop (+ i 1))))",
      "    ;; メッセージを受け取って対応する関数を実行するディスパッチャを返す",
      "    (lambda (msg)",
      "      (case msg",
      "        ((root) root)",
      "        ((unite!) unite!)",
      "        ((same?) same?)",
      "        ((size) size)",
      "        (else (error \"Unknown message\" msg))))))"
    ],
    "description": "Union-Find"
  },
