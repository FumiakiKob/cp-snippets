  "Grids": {
    "scope": "scheme",
    "prefix": "/grids",
    "body": [
      ";; Grids",
      ";; 座標は 1-based の (r . c) 形式",
      "(define (make-grids H W Sentinel)",
      "  (let* ((pitch (+ W 2))",
      "         (size (* (+ H 2) pitch))",
      "         (tiles (make-vector size Sentinel))",
      "         (dist (make-vector size #f)))",
      "    (define (idx r c)",
      "      (+ (* r pitch) c))",
      "    (define (coord->idx coord)",
      "      (idx (car coord) (cdr coord)))",
      "    (define (initialize! lines)",
      "      (let loop ((r 1)",
      "                 (lines lines))",
      "        (unless (null? lines)",
      "          (let ((line (car lines)))",
      "            (let inner ((c 1))",
      "              (if (> c W)",
      "                (loop (+ r 1) (cdr lines))",
      "                (begin",
      "                  (vector-set! tiles (idx r c) (string-ref line (- c 1)))",
      "                  (inner (+ c 1)))))))))",
      "    (define (get-neighbors coord)",
      "      (let ((r (car coord))",
      "            (c (cdr coord)))",
      "        (let loop ((dirs '((-1 . 0) (1 . 0) (0 . -1) (0 . 1)))",
      "                   (acc '()))",
      "          (if (null? dirs)",
      "            acc",
      "            (let* ((d (car dirs))",
      "                   (nr (+ r (car d)))",
      "                   (nc (+ c (cdr d))))",
      "              (if (char=? (vector-ref tiles (idx nr nc)) Sentinel)",
      "                (loop (cdr dirs) acc)",
      "                (loop (cdr dirs) (cons (cons nr nc) acc))))))))",
      "    (lambda (msg)",
      "      (case msg",
      "        ((tile)",
      "         (lambda (coord) (vector-ref tiles (coord->idx coord))))",
      "        ((update-tile!)",
      "         (lambda (coord obj) (vector-set! tiles (coord->idx coord) obj)))",
      "        ((distance)",
      "         (lambda (coord) (vector-ref dist (coord->idx coord))))",
      "        ((update-distance!)",
      "         (lambda (coord d) (vector-set! dist (coord->idx coord) d)))",
      "        ((neighbors) get-neighbors)",
      "        ((initialize!) initialize!)",
      "        (else (error \"Unknown message:\" msg))))))"
    ],
    "description": "Grids"
  },
  "Two-D Sums": {
    "scope": "scheme",
    "prefix": "/2d-sum",
    "body": [
      ";; 二次元累積和",
      "(define (make-2d-sum H W)",
      "  (let* ((height (+ H 1))",
      "         (width (+ W 1))",
      "         (grids (make-vector (* height width) 0))",
      "         (sums (make-vector (* height width) 0)))",
      "    ;; 1始まり",
      "    (define (get-index r c)",
      "      (+ (* r width) c))",
      "    (define (get-grid r c)",
      "      (vector-ref grids (get-index r c)))",
      "    (define (get-sum r c)",
      "      (vector-ref sums (get-index r c)))",
      "    (define (set-grid! r c val)",
      "      (vector-set! grids (get-index r c) val))",
      "    (define (compute!)",
      "      (let row ((i 1))",
      "        (unless (> i H)",
      "          (let col ((j 1))",
      "            (if (> j W)",
      "              (row (+ i 1))",
      "              (begin",
      "                (vector-set! sums (get-index i j)",
      "                  (+ (get-grid i j)",
      "                     (get-sum (- i 1) j)",
      "                     (get-sum i (- j 1))",
      "                     (- (get-sum (- i 1) (- j 1)))))",
      "                (col (+ j 1))))))))",
      "    (define (get-2d-sum r1 c1 r2 c2)",
      "      (let ((top (- r1 1))",
      "            (bottom r2)",
      "            (left (- c1 1))",
      "            (right c2))",
      "        (+ (get-sum bottom right)",
      "           (- (get-sum bottom left))",
      "           (- (get-sum top right))",
      "           (get-sum top left))))",
      "    (lambda (msg)",
      "      (case msg",
      "        ((get-grid) get-grid)",
      "        ((set-grid!) set-grid!)",
      "        ((compute!) (compute!))",
      "        ((get-2d-sum) get-2d-sum)",
      "        (else (error \"Unknown message:\" msg))))))"
    ],
    "description": "Two-D Sums"
  },
  "Segment Tree": {
    "scope": "scheme",
    "prefix": "/segment-tree",
    "body": [
      ";; Segment Tree",
      "(define (make-segment-tree Op N Init-Value Identity-Element)",
      "  (let* ((size (let loop ((i 2))",
      "                (if (>= i N)",
      "                  i",
      "                  (loop (* 2 i)))))",
      "         (tree (make-vector (* 2 size) Init-Value)))",
      "    (define (update! idx val)",
      "      (vector-set! tree idx val)",
      "      (unless (<= idx 1)",
      "        (let* ((parent-idx (div idx 2))",
      "               (left-child (vector-ref tree (* 2 parent-idx)))",
      "               (right-child (vector-ref tree (+ 1 (* 2 parent-idx))))",
      "               (updated-val (Op left-child right-child)))",
      "          (update! parent-idx updated-val))))",
      "    (define (update-pos! pos val)",
      "      (update! (+ pos size) val))",
      "    (define (get query-l query-r)",
      "      (let loop ((idx 1)",
      "                 (node-l 0)",
      "                 (node-r (- size 1)))",
      "        (cond",
      "          ((or (< node-r query-l)",
      "               (< query-r node-l))",
      "           Identity-Element)",
      "          ((and (<= query-l node-l)",
      "                (<= node-r query-r))",
      "           (vector-ref tree idx))",
      "          (else",
      "           (let* ((node-mid (div (+ node-l node-r) 2))",
      "                  (left (loop (* 2 idx) node-l node-mid))",
      "                  (right (loop (+ 1 (* 2 idx)) (+ 1 node-mid) node-r)))",
      "             (Op left right))))))",
      "    (lambda (msg)",
      "      (case msg",
      "        ((update!) update-pos!)",
      "        ((get-val) (lambda (pos) (vector-ref tree (+ pos size))))",
      "        ((get) get)",
      "        (else (error \"Unknown message:\" msg))))))"
    ],
    "description": "Segment Tree"
  },
  "Rolling Hash": {
