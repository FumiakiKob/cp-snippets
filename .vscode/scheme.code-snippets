  "Deque": {
    "scope": "scheme",
    "prefix": "/deque",
    "body": [
      ";; Deque",
      "(define (make-deque capacity)",
      "  ;; #(data-vector head tail size capacity)",
      "  (vector (make-vector capacity) 0 0 0 capacity))",
      ";; 内部アクセサ",
      "(define (dq:vec dq)",
      "  (vector-ref dq 0))",
      "(define (dq:head dq)",
      "  (vector-ref dq 1))",
      "(define (dq:head-set! dq v)",
      "  (vector-set! dq 1 v))",
      "(define (dq:tail dq)",
      "  (vector-ref dq 2))",
      "(define (dq:tail-set! dq v)",
      "  (vector-set! dq 2 v))",
      "(define (dq:size dq)",
      "  (vector-ref dq 3))",
      "(define (dq:size-set! dq v)",
      "  (vector-set! dq 3 v))",
      "(define (dq:cap dq)",
      "  (vector-ref dq 4))",
      ";; 空かどうか",
      "(define (deque-empty? dq)",
      "  (= (dq:size dq) 0))",
      ";; 要素数",
      "(define (deque-len dq)",
      "  (dq:size dq))",
      ";; クリア",
      "(define (deque-clear! dq)",
      "  (dq:head-set! dq 0)",
      "  (dq:tail-set! dq 0)",
      "  (dq:size-set! dq 0))",
      ";; 先頭の要素を参照",
      "(define (deque-peek-front dq)",
      "  (vector-ref (dq:vec dq) (dq:head dq)))",
      ";; 末尾の要素を参照",
      "(define (deque-peek-back dq)",
      "  (let* ((t (dq:tail dq))",
      "         (c (dq:cap dq))",
      "         (prev (if (= t 0) (- c 1) (- t 1))))",
      "    (vector-ref (dq:vec dq) prev)))",
      ";; 先頭に追加",
      "(define (deque-push-front! dq val)",
      "  (let* ((h (dq:head dq))",
      "         (c (dq:cap dq))",
      "         (prev (if (= h 0) (- c 1) (- h 1))))",
      "    (vector-set! (dq:vec dq) prev val)",
      "    (dq:head-set! dq prev)",
      "    (dq:size-set! dq (+ (dq:size dq) 1))))",
      ";; 末尾に追加",
      "(define (deque-push-back! dq val)",
      "  (let* ((t (dq:tail dq))",
      "         (c (dq:cap dq))",
      "         (next (if (= (+ t 1) c) 0 (+ t 1))))",
      "    (vector-set! (dq:vec dq) t val)",
      "    (dq:tail-set! dq next)",
      "    (dq:size-set! dq (+ (dq:size dq) 1))))",
      ";; 先頭を取り出して削除",
      "(define (deque-pop-front! dq)",
      "  (let* ((h (dq:head dq))",
      "         (c (dq:cap dq))",
      "         (next (if (= (+ h 1) c) 0 (+ h 1)))",
      "         (val (vector-ref (dq:vec dq) h)))",
      "    (dq:head-set! dq next)",
      "    (dq:size-set! dq (- (dq:size dq) 1))",
      "    val))",
      ";; 末尾を取り出して削除",
      "(define (deque-pop-back! dq)",
      "  (let* ((t (dq:tail dq))",
      "         (c (dq:cap dq))",
      "         (prev (if (= t 0) (- c 1) (- t 1)))",
      "         (val (vector-ref (dq:vec dq) prev)))",
      "    (dq:tail-set! dq prev)",
      "    (dq:size-set! dq (- (dq:size dq) 1))",
      "    val))",
      ";; ランダムアクセス (0-indexed: 先頭から k 番目)",
      "(define (deque-ref dq k)",
      "  (let* ((h (dq:head dq))",
      "         (c (dq:cap dq))",
      "         (idx (modulo (+ h k) c)))",
      "    (vector-ref (dq:vec dq) idx)))"
    ],
    "description": "Deque"
  },
