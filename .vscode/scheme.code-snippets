    "prefix": "/rolling-hash",
    "body": [
      ";; 累積和ローリングハッシュ",
      "(define (make-rolling-hash str base size)",
      "  (let* ((len (string-length str))",
      "         (h-vec (make-vector (+ len 1) 0))",
      "         (p-vec (make-vector (+ len 1) 1)))",
      "    (let loop ((i 0))",
      "      (when (< i len)",
      "        (let ((code (char->integer (string-ref str i))))",
      "          (vector-set! h-vec (+ i 1) (modulo (+ (* (vector-ref h-vec i) base) code) size))",
      "          (vector-set! p-vec (+ i 1) (modulo (* (vector-ref p-vec i) base) size))",
      "          (loop (+ i 1)))))",
      "    (lambda (l r)",
      "      (if (> l r)",
      "        0",
      "        (let* ((sub-len (+ (- r l) 1))",
      "               (val (- (vector-ref h-vec (+ r 1))",
      "                       (* (vector-ref h-vec l) (vector-ref p-vec sub-len)))))",
      "          (modulo val size))))))"
    ],
    "description": "Rolling Hash"
