    "body": [
      ";; 優先度付きキュー",
      "(define (make-heap entry left right)",
      "  (list entry left right))",
      "(define (heap-entry heap)",
      "  (car heap))",
      "(define (heap-left heap)",
      "  (cadr heap))",
      "(define (heap-right heap)",
      "  (caddr heap))",
      "(define (heap-merge compare h1 h2)",
      "  (cond",
      "    ((null? h1) h2)",
      "    ((null? h2) h1)",
      "    (else",
      "     (let ((v1 (heap-entry h1)) (v2 (heap-entry h2)))",
      "       (if (compare v1 v2)",
      "           (make-heap v1 (heap-merge compare h2 (heap-right h1)) (heap-left h1))",
      "           (make-heap v2 (heap-merge compare h1 (heap-right h2)) (heap-left h2)))))))",
      "(define (heap-push compare heap x)",
      "  (heap-merge compare (make-heap x '() '()) heap))",
      "(define (heap-pop compare heap)",
      "  (heap-merge compare (heap-left heap) (heap-right heap)))",
      "(define (make-priority-queue compare)",
      "  (cons compare '()))",
      "(define (pq-push pq x)",
      "  (let ((compare (car pq))",
      "        (heap (cdr pq)))",
      "    (cons compare (heap-push compare heap x))))",
      "(define (pq-pop pq)",
      "  (let ((compare (car pq))",
      "        (heap (cdr pq)))",
      "    (cons compare (heap-pop compare heap))))",
      "(define (pq-peek pq)",
      "  (heap-entry (cdr pq)))",
