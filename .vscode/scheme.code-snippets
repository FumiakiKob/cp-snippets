  "Treap": {
    "scope": "scheme",
    "prefix": "/treap",
    "body": [
      ";; Treap",
      ";; コンストラクタ",
      "(define (make-tree entry priority multiplicity size left right)",
      "  (list entry priority multiplicity size left right))",
      ";; セレクタ",
      "(define (tree-entry tree) (car tree))",
      "(define (tree-priority tree) (cadr tree))",
      "(define (tree-multiplicity tree)",
      "  (if (null? tree)",
      "      0",
      "      (list-ref tree 2)))",
      "(define (tree-size tree)",
      "  (if (null? tree)",
      "      0",
      "      (list-ref tree 3)))",
      "(define (tree-left tree) (list-ref tree 4))",
      "(define (tree-right tree) (list-ref tree 5))",
      ";; サイズ更新",
      "(define (update-node entry priority multiplicity left right)",
      "  (make-tree entry priority multiplicity (+ multiplicity (tree-size left) (tree-size right)) left right))",
      ";; 3分割",
      "(define (tree-split3 tree k)",
      "  (if (null? tree)",
      "      (list '() '() '())",
      "      (let ((entry (tree-entry tree))",
      "            (priority (tree-priority tree))",
      "            (multiplicity (tree-multiplicity tree))",
      "            (left (tree-left tree))",
      "            (right (tree-right tree)))",
      "        (cond ((< k entry)",
      "               (let* ((result (tree-split3 left k))",
      "                      (L (car result))",
      "                      (M (cadr result))",
      "                      (R (caddr result)))",
      "                 (list L M (update-node entry priority multiplicity R right))))",
      "              ((> k entry)",
      "               (let* ((result (tree-split3 right k))",
      "                      (L (car result))",
      "                      (M (cadr result))",
      "                      (R (caddr result)))",
      "                 (list (update-node entry priority multiplicity left L) M R)))",
      "              (else",
      "               (list left",
      "                     (update-node entry priority multiplicity '() '())",
      "                     right))))))",
      ";; 和（左の全要素 < 右の全要素が前提）",
      "(define (tree-merge left right)",
      "  (cond ((null? left) right)",
      "        ((null? right) left)",
      "        (else",
      "         (let ((p-left (tree-priority left))",
      "               (p-right (tree-priority right)))",
      "           (if (> p-left p-right)",
      "               (update-node (tree-entry left)",
      "                            (tree-priority left)",
      "                            (tree-multiplicity left)",
      "                            (tree-left left)",
      "                            (tree-merge (tree-right left) right))",
      "               (update-node (tree-entry right)",
      "                            (tree-priority right)",
      "                            (tree-multiplicity right)",
      "                            (tree-merge left (tree-left right))",
      "                            (tree-right right)))))))",
      ";; ランダムな優先度",
      "(define random-priority",
      "  (let ((seed 123456789))",
      "    (lambda ()",
      "      (let ((a 1103515245)",
      "            (c 12345)",
      "            (m 4294967296))",
      "        (set! seed (modulo (+ (* seed a) c) m))",
      "        seed))))",
      ";; 重複度の更新",
      "(define (tree-update tree k updater)",
      "  (let* ((result (tree-split3 tree k))",
      "         (L (car result))",
      "         (M (cadr result))",
      "         (R (caddr result))",
      "         (new-multiplicity (updater (tree-multiplicity M))))",
      "    (let ((new-M",
      "            (cond",
      "              ((<= new-multiplicity 0)",
      "               '())",
      "              ((null? M)",
      "               (update-node k (random-priority) new-multiplicity '() '()))",
      "              (else",
      "               (update-node k",
      "                            (tree-priority M)",
      "                            new-multiplicity",
      "                            '() '())))))",
      "      (tree-merge L (tree-merge new-M R)))))",
      ";; 挿入",
      "(define (tree-insert tree k)",
      "  (tree-update tree k (lambda (x) (+ 1 x))))",
      ";; 削除",
      "(define (tree-remove tree k)",
      "  (tree-update tree k (lambda (x) (- x 1))))",
      ";; 検索",
      "(define (tree-member k tree)",
      "  (if (null? tree)",
      "      #f",
      "      (let ((entry (tree-entry tree)))",
      "        (cond ((= k entry)",
      "               tree)",
      "              ((< k entry)",
      "               (tree-member k (tree-left tree)))",
      "              (else",
      "               (tree-member k (tree-right tree)))))))",
      ";; 変換",
      "(define (tree->alist tree)",
      "  (if (null? tree)",
      "      '()",
      "      (append",
      "        (tree->alist (tree-left tree))",
      "        (list (cons (tree-entry tree) (tree-multiplicity tree)))",
      "        (tree->alist (tree-right tree)))))"
    ],
    "description": "Treap"
  },
