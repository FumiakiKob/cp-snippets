  "Combination (mod M)": {
    "scope": "scheme",
    "prefix": "/combination-mod",
    "body": [
      ";; 組合せ計算（mod M）",
      ";; Mは大きな素数",
      "(define (make-combination-mod MAX-N M)",
      "  (let ((fact (make-vector MAX-N 1))",
      "        (fact-inv (make-vector MAX-N 1)))",
      "    (define (mod-M n)",
      "      (mod n M))",
      "    (define (expt-mod a b) ;; (a ^ b) (mod M)",
      "      (let loop ((c 1)",
      "                 (a a)",
      "                 (b b))",
      "        (cond ((= b 0)",
      "               (mod-M c))",
      "              ((= c 0)",
      "               0)",
      "              (else",
      "               (let-values (((q r) (div-and-mod b 2)))",
      "                (if (= r 0)",
      "                    (loop c (mod-M (* a a)) q)",
      "                    (loop (mod-M (* c a)) (mod-M (* a a)) q)))))))",
      "    ;; 事前計算を使った組合せ計算",
      "    (define (nCr n r)",
      "      (if (or (< r 0) (> r n))",
      "          0",
      "          (mod-M",
      "            (* (vector-ref fact n)",
      "               (mod-M",
      "                (* (vector-ref fact-inv r)",
      "                   (vector-ref fact-inv (- n r))))))))",
      "    (define (nHk n k)",
      "      (if (and (= n 0) (= k 0))",
      "          1",
      "          (nCr (+ n k -1) k)))",
      "    ;;階乗の事前計算",
      "    (let loop ((i 1))",
      "      (when (< i MAX-N)",
      "        (vector-set! fact i (mod-M (* (vector-ref fact (- i 1)) i)))",
      "        (loop (+ i 1))))",
      "    ;; 階乗の逆元の事前計算",
      "    (vector-set! fact-inv (- MAX-N 1)",
      "                 (expt-mod (vector-ref fact (- MAX-N 1)) (- M 2)))",
      "    (let loop ((i (- MAX-N 2)))",
      "      (when (>= i 0)",
      "        (vector-set! fact-inv i (mod-M (* (vector-ref fact-inv (+ i 1)) (+ i 1))))",
      "        (loop (- i 1))))",
      "    (lambda (msg)",
      "      (case msg",
      "        ((nCr) nCr)",
      "        ((nHk) nHk)",
      "        ((fact) (lambda (x) (vector-ref fact x)))",
      "        ((fact-inv) (lambda (x) (vector-ref fact-inv x)))",
      "        (else (error \"Unknown message:\" msg))))))"
    ],
    "description": "Combination (mod M)"
  },
  "Fenwick Tree / BIT": {
    "scope": "scheme",
    "prefix": "/BIT",
    "body": [
      ";; Fenwick Tree / BIT",
      "(define (make-BIT N)",
      "  (let* ((BIT (make-vector (+ N 1) 0))",
      "         ;; N 以下の最大の 2 の冪（二分探索の初期ステップ幅）",
      "         (msb (let loop ((p 1))",
      "                (if (<= (* p 2) N)",
      "                  (loop (* p 2))",
      "                  p))))",
      "    (define (lsb x)",
      "      (logand x (- x)))",
      "    (define (BIT-ref idx)",
      "      (vector-ref BIT idx))",
      "    (define (BIT-add! i k)",
      "      (when (> i 0)",
      "        (let loop ((idx i))",
      "          (when (<= idx N)",
      "            (vector-set! BIT idx (+ k (BIT-ref idx)))",
      "            (loop (+ idx (lsb idx)))))))",
      "    (define (BIT-sum i)",
      "      (let loop ((idx (min i N))",
      "                 (acc 0))",
      "        (if (<= idx 0)",
      "          acc",
      "          (loop (- idx (lsb idx))",
      "                (+ acc (BIT-ref idx))))))",
      "    (define (BIT-interval i j)",
      "      (- (BIT-sum j) (BIT-sum (- i 1))))",
      "    (define (BIT-set! i x)",
      "      (let ((prev (BIT-interval i i)))",
      "        (BIT-add! i (- x prev))))",
      "    ;; --- BIT上の二分探索 (要素がすべて非負である前提) ---",
      "    ;; 累積和が >= w となる最小のインデックス (1-indexed) を返す (なければ N + 1)",
      "    (define (BIT-lower-bound w)",
      "      (let loop ((idx 0) (step msb) (acc 0))",
      "        (if (zero? step)",
      "          (+ idx 1)",
      "          (let ((next-idx (+ idx step)))",
      "            (if (and (<= next-idx N) (< (+ acc (BIT-ref next-idx)) w))",
      "              (loop next-idx (div step 2) (+ acc (BIT-ref next-idx)))",
      "              (loop idx (div step 2) acc))))))",
      "    ;; 累積和が > w となる最小のインデックス (1-indexed) を返す (なければ N + 1)",
      "    (define (BIT-upper-bound w)",
      "      (let loop ((idx 0) (step msb) (acc 0))",
      "        (if (zero? step)",
      "          (+ idx 1)",
      "          (let ((next-idx (+ idx step)))",
      "            (if (and (<= next-idx N) (<= (+ acc (BIT-ref next-idx)) w))",
      "              (loop next-idx (div step 2) (+ acc (BIT-ref next-idx)))",
      "              (loop idx (div step 2) acc))))))",
      "    (lambda (msg . args)",
      "      (case msg",
      "        ((add!) BIT-add!)",
      "        ((sum) BIT-sum)",
      "        ((interval) BIT-interval)",
      "        ((set!) BIT-set!)",
      "        ((ref) BIT-ref)",
      "        ((lower-bound) BIT-lower-bound)",
      "        ((upper-bound) BIT-upper-bound)",
      "        (else (error \"Unknown message:\" msg))))))"
    ],
    "description": "Fenwick Tree / BIT"
  },
